<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Package Metadata -->
    <!-- nuget.org reserves the Microsoft.* prefix, so the package and assembly ship under FYIsoft.
         The namespace stays on Microsoft.Extensions.AI, matching the Anthropic provider. -->
    <PackageId>FYIsoft.Extensions.AI.Decision1</PackageId>
    <AssemblyName>FYIsoft.Extensions.AI.Decision1</AssemblyName>
    <RootNamespace>Microsoft.Extensions.AI.Decision1</RootNamespace>
    <Version>0.1.2-preview</Version>
    <Description>Typed .NET client for Microsoft-Decision-1, the Microsoft Foundry decision model. Sends text or JSON state with noul, choice and score questions to the Foundry decision endpoint and returns typed probabilities. Supports Microsoft Entra ID (TokenCredential) and API key authentication, retries with backoff, typed errors and IHttpClientFactory registration.</Description>
    <PackageTags>AI;Microsoft;Foundry;Azure;Decision;Microsoft-Decision-1;Classification;Routing;Scoring</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- These versions become the nuspec minimums, so they stay as low as the library allows:
       consumers on Azure.Identity 1.17.x (Azure.Core 1.50.0) and Microsoft.Extensions 10.0.9 need no
       upgrade. Logging.Abstractions overrides the shared central 10.0.10 that Anthropic and Jev use;
       10.0.9 matches what Microsoft.Extensions.Http 10.0.9 itself requires.
       eng/verify-package-contents.py asserts these exact minimums. -->
  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
</Project>
