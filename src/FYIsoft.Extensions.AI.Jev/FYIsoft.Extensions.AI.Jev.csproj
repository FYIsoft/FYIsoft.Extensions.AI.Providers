<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package Metadata -->
    <!-- nuget.org reserves the Microsoft.* prefix, so the package and assembly ship under FYIsoft.
         The namespaces stay on Microsoft.Extensions.AI so the extension methods need no extra using. -->
    <PackageId>FYIsoft.Extensions.AI.Jev</PackageId>
    <AssemblyName>FYIsoft.Extensions.AI.Jev</AssemblyName>
    <Version>0.1.0-preview</Version>
    <Description>.NET client for TypeSafe AI's Jev (System One) model with Microsoft.Extensions.AI integration. Port of the @typesafe-ai/sdk JavaScript SDK (v0.6.0) plus an IChatClient adapter for structured noul/choice/score judgements.</Description>
    <PackageTags>AI;TypeSafe;Jev;SystemOne;Classification;Microsoft.Extensions.AI;ChatClient</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
